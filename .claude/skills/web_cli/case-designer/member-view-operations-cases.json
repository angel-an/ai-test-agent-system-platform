[
  {
    "name": "会员查看详情",
    "description": "验证在会员列表页面点击查看按钮可以成功查看会员详情",
    "priority": "medium",
    "prerequisites": [
      "用户已登录营销云控制台",
      "会员列表页面已加载",
      "至少存在一个会员"
    ],
    "steps": [
      {
        "step_number": 1,
        "action": "navigate",
        "description": "导航到会员列表页面",
        "target": "会员列表页面",
        "locator": null,
        "data": "https://console-uat.xysjg.com/front/dtcloud-console-web-pc/#/customer/memberlist"
      },
      {
        "step_number": 2,
        "action": "click",
        "description": "点击第一个会员的查看链接",
        "target": "查看链接",
        "locator": "getByText('查看').first()",
        "data": null
      }
    ],
    "expected_result": "成功跳转到会员详情页面，显示该会员的详细信息",
    "verification_points": [
      {
        "type": "element_visible",
        "description": "验证会员详情页面已打开，显示会员详情内容",
        "locator": "getByText('查看').first()",
        "expected": true
      }
    ],
    "page_elements": [
      {
        "name": "查看链接",
        "locator": "getByText('查看').first()",
        "type": "link"
      }
    ],
    "tags": ["member-management", "view", "detail"]
  },
