# AI Test Agent System Platform - Git Ignore Rules

# =============================================================================
# Python
# =============================================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
# 注意：原先的 `lib/` / `lib64/` 会匹配任意层级的同名目录，
# 误将前端正式源码目录（ui/lib、gitnexus-web/src/lib）一并忽略。
# 因此将 Python 打包目录规则限定在 backend/ 下。
backend/lib/
backend/lib64/
# 前端目录名为 lib/ 的源码必须可跟踪（git 规定：父目录被忽略后，
# 对其子文件的否定规则无效，故此处用目录级否定）。
!ui/lib/
!gitnexus-web/src/lib/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# =============================================================================
# Virtual Environment
# =============================================================================
.venv/
venv/
env/
ENV/

# =============================================================================
# IDE
# =============================================================================
.idea/
.vscode/
*.swp
*.swo
*~

# =============================================================================
# Environment & Secrets
# =============================================================================
.env
.env.local
.env.*.local
*.pem
*.key

# =============================================================================
# Logs
# =============================================================================
*.log
logs/
log/

# =============================================================================
# Runtime / Temporary Files
# =============================================================================
*.tmp
*.temp
*.cache
.cache/
.DS_Store
Thumbs.db

# =============================================================================
# Claude / AI Agent - Runtime Artifacts (NEVER commit these)
# =============================================================================

# Playwright CLI snapshots (runtime generated)
*.yml
!pytest.yml
!playwright.yml
after_*.yml
base_*.yml
chat_*.yml
login*.yml
register.yml
webtests_*.yml

# Agent screenshots (runtime generated)
agent_screenshots/
*.png
!docs/**/*.png
!assets/**/*.png
!ui/public/**/*.png
captcha_*.png
login_*.png
marketing_*.png

# Session / Auth files (may contain sensitive data)
auth.json
marketing_auth.json
peets_staging_auth.json
*.state.json

# Agent monitoring logs
agent_monitor.log
thread_last_messages.txt

# =============================================================================
# Webwright Skill - Runtime Artifacts
# =============================================================================
# These are generated during skill execution and should not be committed
.claude/skills/webwright/workspace/final_runs/**/screenshots/
.claude/skills/webwright/workspace/final_runs/**/*.log
.claude/skills/webwright/workspace/final_runs/**/*.txt
.claude/skills/webwright/workspace/playground/*.png
.claude/skills/webwright/workspace/playground/*.jpg

# =============================================================================
# Web CLI / Web MCP - Runtime Test Artifacts
# =============================================================================
# Playwright test execution outputs (runtime generated)
playwright-report*/
test-results/
playwright/.cache/

# =============================================================================
# LangGraph - Runtime Cache Only
# =============================================================================
# Local langgraph overrides now live in core/ directory.
# Only ignore runtime cache, NOT the core/ directory itself.
.langgraph_api/
core/.langgraph_api/

# =============================================================================
# Backup & Archive
# =============================================================================
.backup-*/
.archive/

# =============================================================================
# Node.js (if any frontend)
# =============================================================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# =============================================================================
# Database
# =============================================================================
*.db
*.sqlite
*.sqlite3

# =============================================================================
# Coverage & Test Reports
# =============================================================================
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover
.hypothesis/
.pytest_cache/

# =============================================================================
# Build Outputs
# =============================================================================
*.tsbuildinfo
out/
.next/
.nuxt/
dist/

# =============================================================================
# Project Specific - Keep these
# =============================================================================
# DO NOT ignore:
# - .claude/skills/*/SKILL.md (skill definitions)
# - .claude/skills/*/references/ (skill reference docs)
# - .claude/skills/web_cli/tests/*.spec.ts (generated test scripts - skill outputs)
# - .claude/skills/web_cli/tests/*.json (test case data - skill outputs)
# - .claude/skills/web_cli/tests/*.md (test plans - skill outputs)
# - .claude/skills/web_cli/generated/ (generator outputs)
# - .claude/skills/web_cli/planner/ (planner outputs)
# - .claude/skills/web_cli/case-designer/ (case designer outputs)
# - .claude/skills/webwright/reference/ (skill reference docs)
# - .claude/skills/webwright/workspace/plan.md (skill workspace plan)
# - .claude/skills/security/templates/ (skill templates)

# Agent runtime workspace / conversation / backup artifacts (rev freeze)
backend/app/agents/*/workspace/
**/conversation_history/
**/artifacts_backup/

# 误建/游离的嵌套子树（历史上曾出现 backend/backend/，由错误的 CWD/root
# 复制产生，内含 npm 缓存与报告产物 55MB；清理后加规则防止再次被误提交）
backend/backend/

# npm 本地缓存（node_modules 已单独忽略）
.npm-cache/

# Evidence workspace (contains sensitive data, managed locally)
workspace/evidence/

# 全量回归的工作区临时目录（pytest --basetemp）：沙箱无法删除，避免污染 git status
.pytest-tmp/
backend/.pytest-tmp-round/

# 本机会话产物（rev147 提交前梳理）：运行日志 / 临时目录 / 本地配置 / 运行时数据
.workbuddy/
.claude/settings.local.json
.uvicorn-*.err
*.err.log
.review-rev*-tmp/
.review-rev*-utf8-tmp/
gitnexus-*/
out_yl_case_audit/
workspace/
storage/
test-videos/
KB_E2E_TEST_OUTPUT.txt
KB_SMOKE_TEST_REPORT.json
KB_VERIFICATION_REPORT.json
backend/workspace/
backend/tr94_case_ids.json
backend/verify_round_final.json
