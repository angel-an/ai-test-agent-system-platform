# PR-2 储值充值测试环境变量
# 复制本文件为 .env 并填入真实值
# .env 已加入 .gitignore，禁止提交到版本控制

# UAT 网关地址
PR2_API_BASE_URL=https://your-uat-gateway.com

# 登录凭据（如需自动登录获取 token）
PR2_API_USER=your_username
PR2_API_PASSWORD=your_password

# 会话凭据（已知 token 时直接填写，跳过登录）
PR2_ACCESS_TOKEN=your_access_token
PR2_COOKIE_HEADER=your_cookie_string

# 测试数据
PR2_STORAGE_ACCOUNT_NO=183****0265
PR2_NON_MEMBER_NO=199****0001

# Live 执行开关（默认关闭，只读查询设为 1）
LIVE_API=0

# 可选：PR-2 专属开关（如与全局冲突时使用）
# PR2_LIVE_API=0
