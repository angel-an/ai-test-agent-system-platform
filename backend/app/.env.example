# 测试管理系统环境变量配置示例
# 复制此文件为 .env 并修改配置

# 应用配置
APP_NAME=测试管理系统
APP_VERSION=1.0.0
DEBUG=true

# PostgreSQL 数据库配置
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_test_management

# MongoDB 数据库配置
MONGODB_HOST=121.40.159.60
MONGODB_PORT=27017
MONGODB_USER=
MONGODB_PASSWORD=
MONGODB_DB=ai_test_management

# 速率限制配置
RATE_LIMIT_REQUESTS=300
RATE_LIMIT_WINDOW=60

# 分页配置
PAGINATION_DEFAULT_SIZE=30
PAGINATION_MAX_SIZE=300

# CORS 配置（逗号分隔的域名列表）
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# API 前缀
API_PREFIX=/api/v2

# MinIO 对象存储配置
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=test-management
MINIO_SECURE=false
MINIO_REGION=

# 附件配置
ATTACHMENT_MAX_SIZE=52428800  # 50 MB

# ================= 执行治理层 P0-1：MCP 工具安全策略 =================
# 危险工具黑名单（browser_evaluate / browser_run_code_unsafe 等）默认禁用，无需配置。
# 如需追加禁用模式（按工具名字串匹配，逗号分隔）：
# MCP_DENY_TOOL_PATTERNS=run_code,code_unsafe

# 导航 scheme 门禁：导航工具默认仅允许 http/https/about，
# file:/data:/javascript: 等一律拒绝。确有安全需求时显式追加（逗号分隔）：
# NAVIGATION_ALLOW_SCHEMES=data

# 导航 origin 白名单（逗号分隔）：
#   - 以 '.' 开头 = 后缀匹配（.example.com 匹配 a.example.com / example.com）
#   - 其余 = host 精确匹配（支持 host:port）
#   - localhost / 127.0.0.1 / ::1 始终放行
# 未配置时保持向后兼容放行（过渡行为，启动时告警），生产环境必须配置：
# NAVIGATION_ORIGIN_ALLOWLIST=.example.com,http://localhost:3000

# 强制白名单模式：=1 时若未配置 NAVIGATION_ORIGIN_ALLOWLIST 直接拒绝启动（fail-fast）
# NAVIGATION_ORIGIN_ALLOWLIST_REQUIRED=1

# ================= 执行治理层 P0-1：Shell 执行面策略 =================
# deepagents LocalShellBackend 原为任意命令执行；现已加命令白名单守卫。
# SHELL_POLICY_MODE: enforce（默认，命中策略终局拒绝）| warn（审计放行）| off（关闭，不推荐）
# SHELL_POLICY_MODE=enforce
# 追加白名单命令（逗号分隔；bash/powershell/curl 等黑名单即使追加也拒绝）：
# SHELL_ALLOWED_COMMANDS=mycmd
# 追加黑名单命令（逗号分隔）：
# SHELL_DENY_COMMANDS=tree

# ================= 执行治理层 2b-B3：进程隔离（Windows Job Object）=================
# 脚本执行子进程受 Job Object 限制（内存上限 / 活动进程上限 / 进程树回收 /
# 超时杀整棵进程树）。
# EXEC_JOB_ENABLED=1
# EXEC_JOB_MEMORY_LIMIT_MB=1024
# EXEC_JOB_ACTIVE_PROCESS_LIMIT=32
# 生产环境必须为 1：作业创建/指派/恢复或 Popen 启动任一失败 → 拒绝执行（fail-closed），
# 绝不降级为无保护运行。0 仅限本地开发降级（默认值，需显式确认非生产环境）。
EXEC_JOB_FAIL_CLOSED=1

# P0-2：Web 脚本评审修复循环定时触发间隔（分钟）。>0 时在应用启动时注册
# APScheduler interval 任务（真实 LLM 修复 + proposed 验证）；默认 0 关闭，
# 避免未经配置即消耗 LLM API 额度。按需触发可用 POST /api/v2/web-script-reviews/run-pending。
# WEB_SCRIPT_REPAIR_INTERVAL_MINUTES=5

# rev48：仅显式开发模式才在启动时把默认用户创建/提升为超管。生产必须保持 0
# （安全基线：存量用户默认非超管）。生产授予超管走受控命令：
#   python -m app.cli grant-superuser <username>
# ENABLE_DEV_DEFAULT_SUPERUSER=0

# rev54：导航 origin 白名单（工具级强制生效）。".域"后缀匹配 / host 精确匹配；
# loopback 自动放行；未配置时 http(s) 放行（过渡行为，启动告警）。
# 生产必须配置；NAVIGATION_ORIGIN_ALLOWLIST_REQUIRED=1 时未配置直接拒绝启动。
# NAVIGATION_ORIGIN_ALLOWLIST=.example.com,.uat.mycorp.com
