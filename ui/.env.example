# LangGraph API Configuration
# LangGraph API 的基础 URL
NEXT_PUBLIC_LANGGRAPH_API_URL=http://localhost:8000

# LangGraph API 的端口号
NEXT_PUBLIC_LANGGRAPH_API_PORT=8000

# 测试用例生成智能体的 ID
NEXT_PUBLIC_TESTCASE_GENERATOR_ASSISTANT_ID=testcase_generator_agent

# 后端 API 配置
NEXT_PUBLIC_API_URL=http://localhost:8080

# 需求质量门控人工放行凭证（仅本地开发，留空则禁用自动填充）
# 必须与后端 REQUIREMENT_GATE_OVERRIDE_TOKEN 一致
NEXT_PUBLIC_REQUIREMENT_GATE_OVERRIDE_TOKEN=

